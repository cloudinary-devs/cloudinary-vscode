
# With bundling, we can exclude much more since everything is bundled into dist/extension.js

# Development files
.vscode/**
.vscode-test/**
.cursor/**
.github/**
esbuild.js

# Source files (now bundled)
src/**
out/**
node_modules/**

# Build configuration
tsconfig.json
jsconfig.json

# Test files
test/**

# Documentation and meta files
vsc-extension-quickstart.md
CONTRIBUTING.md

# Logs and temporary files
*.log
npm-debug.log*
*.tmp
*.temp

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~

# Package files
*.vsix

# Git files
.gitignore
.yarnrc

# Internal development
internal/**
temp/**

# Claude Code files
.claude/**
.agents/**
CLAUDE.md

# Development documentation
docs/**

# Local credentials scratch file. The extension reads ~/.cloudinary/environments.json
# and <workspace>/.cloudinary/environments.json, never this one, so it is only ever a
# developer's local copy. It holds apiKey/apiSecret fields, so it must never ship.
environments.json